# Copia este archivo a ".env" y rellena con las claves de tu proyecto Supabase.
# Estas variables son PÚBLICAS (van empaquetadas en el cliente). La seguridad
# real la da Row Level Security (RLS) en Supabase, no el ocultar estas claves.

# URL del proyecto Supabase (Settings -> API -> Project URL)
EXPO_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave pública "anon" (Settings -> API -> Project API keys -> anon public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY
